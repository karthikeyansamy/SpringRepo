package migrator;

import org.apache.hc.client5.http.classic.methods.*;
import org.apache.hc.client5.http.impl.classic.CloseableHttpClient;
import org.apache.hc.client5.http.impl.classic.HttpClients;
import org.apache.hc.core5.http.io.entity.*;
import org.apache.hc.core5.http.*;
import org.apache.hc.core5.http.message.BasicNameValuePair;

import java.io.*;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;

public class ConfluenceExporter {
    private final String baseUrl;
    private final String user;
    private final String pass;

    public ConfluenceExporter(String baseUrl, String user, String pass) {
        this.baseUrl = baseUrl;
        this.user = user;
        this.pass = pass;
    }

    /**
     * Main entry: export, poll, download
     */
    public Path exportSpaceXML(String spaceKey, Path downloadDir, boolean dryRun) throws Exception {
        if (dryRun) {
            System.out.println("[DRY-RUN] Would trigger Confluence XML export for space: " + spaceKey);
            return downloadDir.resolve(spaceKey + "-dummy.zip");
        }

        String taskId = triggerExport(spaceKey);
        System.out.println("Triggered export. LongTask ID=" + taskId);

        String downloadPath = pollUntilComplete(taskId);
        System.out.println("Export ready. File path=" + downloadPath);

        return downloadExport(downloadPath, downloadDir);
    }

    /**
     * POST /spaces/exportspacedata.action → HTML with task ID
     */
    private String triggerExport(String spaceKey) throws Exception {
        String url = baseUrl + "/spaces/exportspacedata.action";

        List<NameValuePair> params = List.of(
                new BasicNameValuePair("key", spaceKey),
                new BasicNameValuePair("exportType", "TYPE_XML"),
                new BasicNameValuePair("includeHistory", "true")
        );

        HttpPost post = new HttpPost(url);
        post.setEntity(new UrlEncodedFormEntity(params));
        post.setHeader(HttpHeaders.AUTHORIZATION, basicAuth());

        try (CloseableHttpClient client = HttpClients.createDefault();
             CloseableHttpResponse response = client.execute(post)) {

            String html = new String(response.getEntity().getContent().readAllBytes());

            // Extract task ID from HTML
            Pattern p = Pattern.compile("taskId=(\d+)");
            Matcher m = p.matcher(html);
            if (m.find()) {
                return m.group(1);
            }

            throw new RuntimeException("Unable to find longtask ID in Confluence response.");
        }
    }

    /**
     * Poll /rest/api/longtask/{taskId} until SUCCESS
     */
    private String pollUntilComplete(String taskId) throws Exception {
        String url = baseUrl + "/rest/api/longtask/" + taskId;

        while (true) {
            HttpGet get = new HttpGet(url);
            get.setHeader(HttpHeaders.AUTHORIZATION, basicAuth());

            try (CloseableHttpClient client = HttpClients.createDefault();
                 CloseableHttpResponse resp = client.execute(get)) {
                String json = new String(resp.getEntity().getContent().readAllBytes());

                if (json.contains("SUCCESS")) {
                    return extractDownloadPath(json);
                }

                if (json.contains("FAILED")) {
                    throw new RuntimeException("Confluence export failed: " + json);
                }

                System.out.println("Waiting export…");
                Thread.sleep(4000);
            }
        }
    }

    /** Extract file path from JSON */
    private String extractDownloadPath(String json) {
        Pattern p = Pattern.compile("\\"downloadPath\\"\s*:\s*\\"([^\\"]+)\\"");
        Matcher m = p.matcher(json);
        if (m.find()) return m.group(1);
        throw new RuntimeException("Cannot find download path in task result.");
    }

    /** Download ZIP */
    private Path downloadExport(String downloadPath, Path downloadDir) throws Exception {
        String url = baseUrl + downloadPath;
        HttpGet get = new HttpGet(url);
        get.setHeader(HttpHeaders.AUTHORIZATION, basicAuth());

        try (CloseableHttpClient client = HttpClients.createDefault();
             CloseableHttpResponse resp = client.execute(get)) {

            if (resp.getCode() != 200) {
                throw new RuntimeException("Download failed: HTTP " + resp.getCode());
            }

            String fileName = Optional.ofNullable(getFileName(downloadPath)).orElse("export.zip");
            Path out = downloadDir.resolve(fileName);
            Files.copy(resp.getEntity().getContent(), out, StandardCopyOption.REPLACE_EXISTING);
            System.out.println("Downloaded → " + out);
            return out;
        }
    }

    private String getFileName(String path) {
        int slash = path.lastIndexOf('/');
        return slash >= 0 ? path.substring(slash + 1) : null;
    }

    private String basicAuth() {
        String token = Base64.getEncoder().encodeToString((user + ":" + pass).getBytes());
        return "Basic " + token;
    }
}
