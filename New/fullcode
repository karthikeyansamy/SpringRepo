package migrator;

import picocli.CommandLine;

import java.nio.file.*;

public class Main implements Runnable {

    @CommandLine.Option(names = "--confluenceUrl", required = true)
    String confluenceUrl;

    @CommandLine.Option(names = "--confluenceUser", required = true)
    String confluenceUser;

    @CommandLine.Option(names = "--confluencePass", required = true)
    String confluencePass;

    @CommandLine.Option(names = "--spaceKey", required = true)
    String spaceKey;

    @CommandLine.Option(names = "--xwikiUrl", required = true)
    String xwikiUrl;

    @CommandLine.Option(names = "--xwikiUser", required = true)
    String xwikiUser;

    @CommandLine.Option(names = "--xwikiPass", required = true)
    String xwikiPass;

    @CommandLine.Option(names = "--downloadDir", defaultValue = "./downloads")
    String downloadDir;

    @CommandLine.Option(names = "--dryRun", defaultValue = "false")
    boolean dryRun;

    @Override
    public void run() {
        try {
            Path downloadPath = Path.of(downloadDir);
            Files.createDirectories(downloadPath);

            ConfluenceExporter exporter = new ConfluenceExporter(
                    confluenceUrl, confluenceUser, confluencePass);

            Path exportedZip = exporter.exportSpaceXML(spaceKey, downloadPath, dryRun);

            if (dryRun) {
                System.out.println("[DRY-RUN] Would next import into XWiki");
                return;
            }

            XWikiImporter importer = new XWikiImporter(xwikiUrl, xwikiUser, xwikiPass);
            importer.importZip(exportedZip, spaceKey);

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static void main(String[] args) {
        CommandLine.run(new Main(), args);
    }
}
