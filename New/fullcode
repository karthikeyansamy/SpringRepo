// Recommended-parameter XWikiImporter (Option B)
public class XWikiImporter {
    // v2 importer aligned exactly with Confluence XML importer repo definitions
    // Uses Job REST API, form token, and ConfluenceInputProperties parameters

    private static final Logger log = LoggerFactory.getLogger(XWikiImporter.class);
    private final String xwikiBaseUrl;
    private final String username;
    private final String password;

    public XWikiImporter(String xwikiBaseUrl, String username, String password) {
        this.xwikiBaseUrl = xwikiBaseUrl;
        this.username = username;
        this.password = password;
    }

    private String fetchFormToken() throws Exception {
        String url = xwikiBaseUrl + "/rest/wikis/xwiki/formtoken";
        try (CloseableHttpClient client = HttpClients.custom()
                .setDefaultCredentialsProvider(AuthUtils.basicAuth(username, password))
                .build()) {
            HttpGet get = new HttpGet(url);
            return client.execute(get, response -> EntityUtils.toString(response.getEntity())).trim();
        }
    }

    public String submitImportJob(String sourceFile) throws Exception {
        String formToken = fetchFormToken();

        String jobUrl = xwikiBaseUrl + "/rest/wikis/xwiki/jobs?jobType=confluence.xml&form_token=" + formToken;
        List<NameValuePair> params = new ArrayList<>();

        // EXACT parameters from ConfluenceInputProperties
        params.add(new BasicNameValuePair("source", sourceFile));
        params.add(new BasicNameValuePair("strict", "false"));
        params.add(new BasicNameValuePair("filterLogEnabled", "true"));
        params.add(new BasicNameValuePair("preserveTimestamps", "true"));
        params.add(new BasicNameValuePair("preserveUserNames", "true"));
        params.add(new BasicNameValuePair("createMissingUsers", "true"));
        params.add(new BasicNameValuePair("importAttachments", "true"));
        params.add(new BasicNameValuePair("importComments", "true"));
        params.add(new BasicNameValuePair("importPageHistory", "true"));
        params.add(new BasicNameValuePair("failOnError", "false"));
        params.add(new BasicNameValuePair("verbose", "true"));
        params.add(new BasicNameValuePair("spaceMappingStrategy", "APPEND"));

        try (CloseableHttpClient client = HttpClients.custom()
                .setDefaultCredentialsProvider(AuthUtils.basicAuth(username, password))
                .build()) {

            HttpPost post = new HttpPost(jobUrl);
            post.setEntity(new UrlEncodedFormEntity(params));

            String json = client.execute(post, response -> EntityUtils.toString(response.getEntity()));
            return JobUtils.extractJobId(json);
        }
    }

    public void waitForJobCompletion(String jobId) throws Exception {
        String url = xwikiBaseUrl + "/rest/wikis/xwiki/jobs/" + jobId;
        try (CloseableHttpClient client = HttpClients.custom()
                .setDefaultCredentialsProvider(AuthUtils.basicAuth(username, password))
                .build()) {
            while (true) {
                HttpGet get = new HttpGet(url);
                String state = client.execute(get, r -> EntityUtils.toString(r.getEntity()));
                if (state.contains("FINISHED")) return;
                if (state.contains("FAILED")) throw new IllegalStateException("Import failed: " + state);
                Thread.sleep(3000);
            }
        }
    }
}
